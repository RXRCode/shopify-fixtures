{
  "name": "@rxrcode/shopify-fixtures",
  "version": "0.2.0",
  "description": "Reproducible development data for Shopify.",
  "type": "module",
  "bin": {
    "rxr-fixtures": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/safety.md",
    "docs/shopify-setup.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings=0",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "shopify",
    "fixtures",
    "development-store",
    "metaobjects",
    "metafields",
    "testing"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rxrcode/shopify-fixtures.git"
  },
  "homepage": "https://github.com/rxrcode/shopify-fixtures#readme",
  "bugs": {
    "url": "https://github.com/rxrcode/shopify-fixtures/issues"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.2.1",
    "picocolors": "^1.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.11"
  }
}
